RewriteEngine On

# 1. Rediriger tout le trafic vers le dossier 'out' (votre site statique)
# Assurez-vous d'avoir téléchargé le contenu du dossier 'out/' dans votre public_html
RewriteCond %{REQUEST_URI} !^/out/
RewriteRule ^(.*)$ /out/$1 [L]

# 2. Gestion des routes Next.js (supprime l'extension .html dans l'URL)
RewriteCond %{DOCUMENT_ROOT}/out/$1.html -f
RewriteRule ^(.*)$ $1.html [L]

# 3. Optimisation du cache pour les fichiers statiques
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>
