{
  "kind": "collectionType",
  "collectionName": "message_contacts",
  "info": {
    "singularName": "message-contact",
    "pluralName": "message-contacts",
    "displayName": "MessageContact"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nom": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "telephone": {
      "type": "string"
    },
    "sujet": {
      "type": "string",
      "required": true
    },
    "message": {
      "type": "text",
      "required": true
    },
    "statut": {
      "type": "enumeration",
      "required": true,
      "default": "non_lu",
      "enum": [
        "non_lu",
        "lu",
        "traite"
      ]
    },
    "date_creation": {
      "type": "datetime"
    }
  }
}
